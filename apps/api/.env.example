# ============================================================
# OBRIGATÓRIO
# ============================================================

# PostgreSQL (o docker-compose da raiz cria o banco "pta")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pta?schema=public"

# Segredo dos tokens de login: string aleatória com 32+ caracteres.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# ============================================================
# SERVIDOR
# ============================================================
PORT=3000
# Endereço(s) do frontend autorizados a chamar a API (separados por vírgula)
CORS_ORIGIN="http://localhost:3001"
# Endereço do frontend, usado nos links enviados por e-mail
WEB_URL="http://localhost:3001"
# Validade da sessão
JWT_EXPIRES_IN="8h"

# Portal do aluno: validade do link de acesso enviado ao aluno (dias) e da sessão (horas)
LINK_ALUNO_DIAS=7
SESSAO_ALUNO_HORAS=12

# Primeiro administrador (usado por: npm run db:seed)
ADMIN_NOME="Administrador"
ADMIN_EMAIL=""
ADMIN_SENHA=""

# ============================================================
# REGRAS ACADÊMICAS
# ============================================================
INSTITUICAO_NOME="PTA - Gestão Acadêmica de Pós-Graduação"
# Nota da avaliação de cada módulo, de 0 a 100 (aprovado com MEDIA_MINIMA ou mais)
MEDIA_MINIMA=70
# Frequência mínima em % (0 = não exigir). A Resolução CNE/CES nº 1/2018 exige 75%.
FREQUENCIA_MINIMA=75
# Quantidade de módulos de cada turma (0 = sem limite)
MODULOS_POR_TURMA=18

# ============================================================
# CERTIFICAÇÃO E AVISOS
# ============================================================
# Prazo da certificadora a partir do envio do lote, e aviso à equipe N dias antes de vencer
PRAZO_CERTIFICADORA_DIAS=30
ALERTA_PRAZO_DIAS=5
# Avisos por e-mail (alunos, certificadora e equipe). Sem SMTP, aparecem só no console.
AVISOS_EMAIL=true
# Lembrete de pendências aos alunos a cada N dias (0 = desligado)
LEMBRETE_PENDENCIAS_DIAS=7

# ============================================================
# ARQUIVOS
# Sem Google Drive configurado, os arquivos ficam nesta pasta local.
# ============================================================
STORAGE_DIR="storage"
UPLOAD_MAX_MB=20

# ============================================================
# OPCIONAL: GOOGLE DRIVE
# Ativado quando GOOGLE_DRIVE_FOLDER_ID + uma forma de credencial estiverem preenchidos.
# ============================================================
# ID da pasta raiz (o trecho final da URL da pasta no Drive)
GOOGLE_DRIVE_FOLDER_ID=""
# false (padrão): os arquivos ficam no servidor e vão ao Drive pelo botão "Exportar para o Google Drive"
# na página do aluno. true: cada arquivo vai direto ao Drive no momento do envio.
GOOGLE_DRIVE_ENVIO_AUTOMATICO=false

# Opção A: OAuth de um usuário (use esta para contas Gmail pessoais)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""

# Opção B: conta de serviço (exige Drive compartilhado do Google Workspace,
# pois contas de serviço não têm cota no "Meu Drive"). Compartilhe a pasta com o e-mail da conta.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Chave em uma linha só, com \n no lugar das quebras de linha
GOOGLE_PRIVATE_KEY=""
# ...ou o JSON inteiro da conta de serviço em uma linha
GOOGLE_SERVICE_ACCOUNT_JSON=""
# ...ou o caminho do arquivo JSON
GOOGLE_APPLICATION_CREDENTIALS=""

# ============================================================
# OPCIONAL: E-MAIL (login por link mágico)
# Sem SMTP, em desenvolvimento o link aparece no console da API.
# ============================================================
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PTA Gestão Acadêmica <nao-responda@seudominio.com.br>"

# ============================================================
# OPCIONAL: CADEMI (importação das notas dos módulos)
# A leitura das notas precisa ser implementada em src/lib/cademi.ts quando
# houver a documentação da API. Vincule cada módulo pelo campo "ID na Cademi".
# ============================================================
CADEMI_API_URL=""
CADEMI_API_TOKEN=""
# Importação automática a cada N minutos (0 = só pelo botão na turma)
CADEMI_SINCRONIZAR_A_CADA_MINUTOS=0

# ============================================================
# OPCIONAL: REDIS (fila de geração de históricos)
# Sem Redis, os históricos são gerados no próprio processo da API.
# ============================================================
REDIS_URL=""
