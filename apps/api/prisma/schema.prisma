generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SECRETARIA
  PROFESSOR
  // Acesso externo e limitado: só vê os lotes enviados e registra os certificados
  CERTIFICADORA
  // Só mantém a situação (financeira) das matrículas
  FINANCEIRO
}

// Mantida à mão pelo financeiro (a Eduzz não tem API). Só CANCELADO fica fora dos lotes de certificação.
enum SituacaoMatricula {
  EM_DIA
  TRIAL
  ATRASADO
  SUSPENSO
  CANCELADO
  QUITADO
  FINALIZADO
}

enum CondicaoGraduacao {
  CURSANDO
  CONCLUIDO_SEM_DIPLOMA
  CONCLUIDO_COM_DIPLOMA
}

enum TipoDocumento {
  RG
  CPF
  COMPROVANTE_ENDERECO
  HISTORICO_GRADUACAO
  DIPLOMA
  DECLARACAO_CONCLUSAO
  DECLARACAO_MATRICULA
  CERTIDAO_NASCIMENTO_CASAMENTO
  OUTRO
}

enum StatusDocumento {
  PENDENTE
  APROVADO
  REJEITADO
}

// VERMELHO: falta documentação | AMARELO: falta avaliação (documento ou nota) | VERDE: tudo certo
enum StatusSemaforo {
  VERDE
  AMARELO
  VERMELHO
}

enum OrigemNota {
  MANUAL
  CADEMI
}

enum StatusSincronizacao {
  EM_ANDAMENTO
  SUCESSO
  PARCIAL
  ERRO
}

// ABERTO: montando | ENVIADO: com a certificadora (prazo correndo) | CONCLUIDO: todos os certificados registrados
enum StatusLote {
  ABERTO
  ENVIADO
  CONCLUIDO
}

enum StatusSolicitacao {
  PENDENTE
  APROVADA
  RECUSADA
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  role         Role     @default(SECRETARIA)
  // Usuários do perfil CERTIFICADORA: de qual certificadora (só veem os lotes dela)
  certificadoraId String?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  documentosEnviados   Documento[] @relation("DocumentoEnviadoPor")
  documentosAnalisados Documento[] @relation("DocumentoAnalisadoPor")
  notasLancadas        Nota[]
  auditLogs            AuditLog[]
  magicLinks           MagicLink[]
  sincronizacoesCademi SincronizacaoCademi[]
  lotesCriados         LoteCertificacao[]     @relation("LoteCriadoPor")
  certificadosRegistrados ItemLote[]          @relation("CertificadoRegistradoPor")
  solicitacoesAnalisadas SolicitacaoAlteracao[]
  certificadora        Certificadora?         @relation(fields: [certificadoraId], references: [id], onDelete: SetNull)
}

// Instituição que emite os certificados (ex.: INOVE, USINA). Cada lote vai para uma delas.
model Certificadora {
  id           String   @id @default(uuid())
  nome         String   @unique
  email        String?
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios Usuario[]
  lotes    LoteCertificacao[]
}

model Turma {
  id           String   @id @default(uuid())
  // Sigla da turma (ex.: "B7", "TF4"), a mesma das abas da planilha antiga
  codigo       String?  @unique
  // Nome da turma, como sai em "Pós-Graduado no curso de:" (ex.: "Biomecânica... - B7")
  nome         String
  // Nome do curso no título do histórico (ex.: "Biomecânica..."). Vazio = usa o nome da turma
  curso        String?
  resolucaoMec String?
  cargaHoraria Int      @default(360)
  dataInicio   DateTime
  dataFim      DateTime
  ativa        Boolean  @default(true)
  // Link público de inscrição (/inscricao/<codigo>)
  codigoInscricao   String? @unique
  inscricoesAbertas Boolean @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  disciplinas          Disciplina[]
  matriculas           Matricula[]
  sincronizacoesCademi SincronizacaoCademi[]
}

// Módulo/disciplina de uma turma. A ordem varia conforme a pós.
model Disciplina {
  id           String   @id @default(uuid())
  turmaId      String
  ordem        Int
  nome         String
  cargaHoraria Int      @default(0)
  docente      String?
  titulacao    String?
  // ID do módulo/avaliação correspondente na Cademi (de onde vêm as notas)
  cademiId     String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  turma Turma  @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  notas Nota[]

  @@unique([turmaId, cademiId])
  @@index([turmaId, ordem])
}

model Aluno {
  id                String            @id @default(uuid())
  nome              String
  cpf               String            @unique
  email             String
  telefone          String?
  dataNascimento    DateTime?
  nacionalidade     String?
  naturalidade      String?
  filiacao          String?
  rgNumero          String?
  rgOrgaoEmissor    String?
  condicaoGraduacao CondicaoGraduacao @default(CURSANDO)
  enderecoRua         String?
  enderecoNumero      String?
  enderecoComplemento String?
  enderecoBairro      String?
  enderecoCep         String?
  enderecoCidade      String?
  enderecoEstado      String?
  grupoWhatsapp       Boolean?
  ganhouCamiseta      Boolean?
  // Veio da importação da planilha antiga
  importadoEm         DateTime?
  driveFolderId     String?
  driveExportadoEm  DateTime?
  // ID do aluno na Cademi: preenchido na primeira importação (casando por CPF/e-mail) ou manualmente
  cademiId          String?           @unique
  // Portal do aluno: hash do link de acesso atual (gerar outro invalida o anterior)
  acessoTokenHash   String?           @unique
  acessoExpiraEm    DateTime?
  // Cadastrado pelo próprio aluno no link de inscrição da turma
  inscricaoOnline   Boolean           @default(false)
  // Último lembrete de pendências enviado por e-mail
  ultimoLembreteEm  DateTime?
  statusSemaforo    StatusSemaforo    @default(VERMELHO)
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt

  matriculas   Matricula[]
  documentos   Documento[]
  notas        Nota[]
  solicitacoes SolicitacaoAlteracao[]
  notificacoes Notificacao[]
}

model Matricula {
  id                String    @id @default(uuid())
  alunoId           String
  turmaId           String
  // Data de entrada do aluno na turma
  dataInclusao      DateTime  @default(now())
  // Número de matrícula (virá da Cademi; os antigos vêm da planilha)
  numeroMatricula   String?
  situacao          SituacaoMatricula @default(EM_DIA)
  situacaoAtualizadaEm DateTime?
  dataCancelamento  DateTime?
  // Troca de turma: as notas não passam, o aluno refaz as avaliações da turma nova
  entrouPorMigracao Boolean   @default(false)
  saiuPorMigracao   Boolean   @default(false)
  // Referência do PDF final do histórico ("local:<caminho>" ou "drive:<fileId>")
  historicoRef      String?
  historicoLink     String?
  // Cópia do histórico exportada para o Google Drive
  historicoDriveFileId String?
  // Impressão digital do conteúdo do histórico: evita regerar o PDF quando nada que aparece nele mudou
  historicoHash     String?
  historicoGeradoEm DateTime?

  aluno    Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma    Turma     @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  itemLote ItemLote?

  @@unique([alunoId, turmaId])
  @@index([turmaId])
  @@index([situacao])
  @@index([numeroMatricula])
}

model Documento {
  id             String          @id @default(uuid())
  alunoId        String
  tipo           TipoDocumento
  nomeArquivo    String
  mimeType       String
  tamanho        Int
  // Referência do arquivo ("local:<caminho>", "drive:<fileId>" ou "externo:<link>" para os documentos
  // conferidos antes do sistema, que continuam só na pasta antiga do Drive)
  arquivoRef     String
  // Cópia exportada para o Google Drive (exportação manual da pasta do aluno)
  driveFileId    String?
  driveLink      String?
  status         StatusDocumento @default(PENDENTE)
  motivoRejeicao String?
  enviadoPorId   String?
  analisadoPorId String?
  analisadoEm    DateTime?
  criadoEm       DateTime        @default(now())
  atualizadoEm   DateTime        @updatedAt

  aluno       Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  enviadoPor  Usuario? @relation("DocumentoEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)
  analisadoPor Usuario? @relation("DocumentoAnalisadoPor", fields: [analisadoPorId], references: [id], onDelete: SetNull)

  @@index([alunoId])
  @@index([status])
}

// Nota de 0 a 100, uma por aluno/disciplina. Curso EAD: a frequência é sempre 100% (vazio conta como 100).
model Nota {
  id           String   @id @default(uuid())
  alunoId      String
  disciplinaId String
  media        Float?
  frequencia   Float?
  lancadoPorId String?
  origem       OrigemNota @default(MANUAL)
  importadoEm  DateTime?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  aluno      Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  disciplina Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  lancadoPor Usuario?   @relation(fields: [lancadoPorId], references: [id], onDelete: SetNull)

  @@unique([alunoId, disciplinaId])
}

model AuditLog {
  id         String   @id @default(uuid())
  acao       String
  entidade   String
  entidadeId String
  usuarioId  String?
  detalhes   String?
  criadoEm   DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidade, entidadeId])
  @@index([criadoEm])
}

model MagicLink {
  id        String   @id @default(uuid())
  // Guardamos apenas o hash SHA-256 do token enviado por e-mail
  tokenHash String   @unique
  usuarioId String
  usado     Boolean  @default(false)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Histórico de importações de notas da Cademi
model SincronizacaoCademi {
  id              String              @id @default(uuid())
  turmaId         String
  usuarioId       String?
  automatica      Boolean             @default(false)
  status          StatusSincronizacao @default(EM_ANDAMENTO)
  notasImportadas Int                 @default(0)
  notasIgnoradas  Int                 @default(0)
  // JSON com alunos/módulos da Cademi não encontrados aqui, registros ignorados ou a mensagem de erro
  detalhes        String?
  iniciadoEm      DateTime            @default(now())
  concluidoEm     DateTime?

  turma   Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([turmaId, iniciadoEm])
}

// Lote mensal enviado à certificadora
model LoteCertificacao {
  id            String     @id @default(uuid())
  // Mês de referência, "AAAA-MM"
  referencia    String
  status        StatusLote @default(ABERTO)
  enviadoEm     DateTime?
  prazoEm       DateTime?
  concluidoEm   DateTime?
  // Pasta do lote no Google Drive (uma subpasta por aluno) e a planilha-índice
  driveFolderId String?
  driveIndiceId String?
  // Reconstruído a partir da planilha antiga: não gera alertas de prazo
  importado     Boolean    @default(false)
  certificadoraId String?
  criadoPorId   String?
  criadoEm      DateTime   @default(now())
  atualizadoEm  DateTime   @updatedAt

  criadoPor     Usuario?       @relation("LoteCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  certificadora Certificadora? @relation(fields: [certificadoraId], references: [id], onDelete: SetNull)
  itens         ItemLote[]

  @@index([status])
  @@index([certificadoraId])
}

// Um aluno (matrícula) dentro de um lote; cada matrícula entra em um único lote
model ItemLote {
  id                   String    @id @default(uuid())
  loteId               String
  matriculaId          String    @unique
  driveFolderId        String?
  certificadoNumero    String?
  certificadoEmitidoEm DateTime?
  // Certificado digital (PDF) guardado na pasta do aluno e entregue a ele
  certificadoRef       String?
  certificadoNomeArquivo String?
  certificadoEnviadoEm DateTime?
  // "email" (enviado pelo sistema) ou "manual" (registrado pela equipe)
  certificadoCanal     String?
  // Anotação da certificadora ou da equipe (ex.: "FALTA CPF", "Enviado para a IES")
  observacao           String?
  registradoPorId      String?
  criadoEm             DateTime  @default(now())
  atualizadoEm         DateTime  @updatedAt

  lote          LoteCertificacao @relation(fields: [loteId], references: [id], onDelete: Cascade)
  matricula     Matricula        @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  registradoPor Usuario?         @relation("CertificadoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([loteId])
}

// Pedido do aluno (portal) para alterar um dado já preenchido; a secretaria aprova ou recusa
model SolicitacaoAlteracao {
  id             String            @id @default(uuid())
  alunoId        String
  // JSON: { campo: { atual, novo } }
  dados          String
  status         StatusSolicitacao @default(PENDENTE)
  motivoRecusa   String?
  analisadoPorId String?
  analisadoEm    DateTime?
  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt

  aluno        Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  analisadoPor Usuario? @relation(fields: [analisadoPorId], references: [id], onDelete: SetNull)

  @@index([alunoId, status])
  @@index([status])
}

// Registro dos avisos enviados por e-mail
model Notificacao {
  id         String   @id @default(uuid())
  alunoId    String?
  para       String
  tipo       String
  // Evita repetir o mesmo aviso (ex.: um aviso de "certificado emitido" por matrícula)
  referencia String?
  assunto    String
  enviado    Boolean
  erro       String?
  criadoEm   DateTime @default(now())

  aluno Aluno? @relation(fields: [alunoId], references: [id], onDelete: SetNull)

  @@index([alunoId, criadoEm])
  @@index([tipo, referencia])
}
